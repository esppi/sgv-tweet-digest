# systemd USER unit TEMPLATE — feedback loop stage 1: match posted tweets to drafted ideas.
#
# THIS is what makes the feedback loop live: it writes tweet_idea_matches, which
# sgv-feedback-profile joins against at 13:30. Runs after our-tweets-fetcher (12:30)
# has snapshotted the latest posted tweets.
#
# Install: see deploy/README.md. Copy to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now sgv-idea-matcher.timer
#
# Needs ANTHROPIC_API_KEY (Sonnet judge, ~$0.003/pair, capped at 50 pairs/run).
# EnvironmentFile must define SKILL_DIR + VENV_PYTHON as ABSOLUTE paths
# (systemd does NOT expand $HOME in EnvironmentFile). %h expands to your home directory.

[Unit]
Description=SGV Tweet Digest — idea matcher: link posted tweets to drafted ideas (feedback loop stage 1)
After=network-online.target sgv-our-tweets-fetcher.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=TZ=UTC
EnvironmentFile=%h/.config/sgv-tweet-digest/env
WorkingDirectory=%h
ExecStart=/bin/bash -c 'exec "$VENV_PYTHON" "$SKILL_DIR/scripts/idea_matcher.py"'
StandardOutput=append:%h/.local/state/sgv-tweet-digest/idea-matcher.log
StandardError=append:%h/.local/state/sgv-tweet-digest/idea-matcher.log
TimeoutStartSec=300

[Install]
WantedBy=default.target
