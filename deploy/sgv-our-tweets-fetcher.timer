# systemd USER timer TEMPLATE — Stage B runs daily at 12:30 UTC (30 min before the digest).
# Install: see deploy/README.md.

[Unit]
Description=SGV Tweet Digest — fetch our own tweets daily at 12:30 UTC (30 min before digest)

[Timer]
OnCalendar=*-*-* 12:30:00 UTC
Persistent=true
Unit=sgv-our-tweets-fetcher.service

[Install]
WantedBy=timers.target
