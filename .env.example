# sgv-tweet-digest — environment template
# ---------------------------------------------------------------------------
# Copy this file to your real env file (recommended: ~/.config/sgv-tweet-digest/env,
# which is what the deploy/ systemd units load) and fill in YOUR values.
# The real env file is gitignored. Each operator supplies their OWN credentials
# (see SECRETS-TO-SHARE.md).
#
# ⚠️  SYSTEMD WARNING — READ THIS FIRST
#   systemd `EnvironmentFile` does NOT expand $HOME, ~, or any $VARIABLE.
#   A value like `$HOME/.local/...` stays the literal string `$HOME/.local/...`.
#   → Use ABSOLUTE paths (e.g. /home/youruser/...) for every path value here.
#   (The scripts defensively expand $HOME/~ where they can, but don't rely on it.)
#
#   Interactive use (`source .env` in a shell) expands variables normally.
#
# Everything in the OPTIONAL sections below is COMMENTED OUT on purpose: the
# scripts compute correct defaults (XDG state/config dirs) at runtime. Only
# uncomment a knob to override it.
#
# Legend:  [REQUIRED] must be set   [OPTIONAL] has a built-in default / feature off
#          (secret)  never commit / never share   (non-secret)  safe to share
# ---------------------------------------------------------------------------

# === Anthropic ===
# [REQUIRED] (secret) Opus + Sonnet calls — the whole product (scoring, drafting,
# insights, good-content, idea matching, feedback profile, voice-profile rebuild).
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === X / Twitter API ===
# [REQUIRED] (secret) X API v2 app-only Bearer — list tweets, following,
# single-tweet fetch (paid metered tier). From your X developer app.
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAxxxxxxxxxxxxxxxxxxxx

# OAuth2 user token — reads YOUR followed Lists, /following, and own timeline
# (app-only auth 403s on those). Authorize an OAuth2 app against your OWN
# @handle: run `python3 scripts/oauth_bootstrap.py` once (see README).
# [REQUIRED] (secret)
X_OAUTH2_CLIENT_ID=your_oauth2_client_id
# [REQUIRED] (secret) the long-lived refresh token minted by oauth_bootstrap.py
X_OAUTH2_REFRESH_TOKEN=your_oauth2_refresh_token
# [OPTIONAL] (secret) only for confidential clients; omit for public clients
#X_OAUTH2_CLIENT_SECRET=your_oauth2_client_secret

# === Telegram ===
# Telethon application credentials from https://my.telegram.org (API development
# tools). They tie a USER session to your account — keep them private.
# [REQUIRED] (secret)
TELEGRAM_API_ID=1234567
# [REQUIRED] (secret)
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# [REQUIRED] (secret) ABSOLUTE path to the Telethon user-session file. Created on
# first login (one-time phone+code). NEVER share it — concurrent use revokes it.
TELEGRAM_SESSION=/home/youruser/.local/share/sgv-tweet-digest/session.session
# [REQUIRED] (secret) BotFather bot token for personal (mist-voice) DM delivery.
# The bot's @handle is derived from this token — no handle is hardcoded.
TELEGRAM_BOT_TOKEN=123456:ABC-DEFxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [REQUIRED] (non-secret) Telegram group id for fund (sgv-voice) delivery.
# Supergroup ids look like -100xxxxxxxxxx.
TELEGRAM_DELIVERY_CHAT_SGV=-1001234567890
# [REQUIRED] (non-secret) Telegram user/DM id for personal (mist-voice) delivery.
TELEGRAM_DELIVERY_CHAT_MIST=123456789

# === Paths the systemd units need (ABSOLUTE — see the warning above) ===
# [REQUIRED for deploy/] (non-secret) where this skill repo is installed.
SKILL_DIR=/home/youruser/.claude/skills/sgv-tweet-digest
# [REQUIRED] (non-secret) Telethon-capable Python interpreter (the digest + all
# Telegram I/O). The stdlib-only gatherers can use system python3.
VENV_PYTHON=/home/youruser/.local/share/sgv-tweet-digest/venv/bin/python3
# [OPTIONAL] (non-secret) interpreter for the stdlib-only gather stage; the
# gather unit falls back to `python3` on PATH when unset.
#SYSTEM_PYTHON=/usr/bin/python3

# === Optional news source ===
# [OPTIONAL] (non-secret) Telegram news channel/username the digest reads for
# market context. Leave commented to skip the news-context pull.
#SHOAL_CHANNEL=shoalresearch

# === Optional insights sources (insights.py) ===
# Each source is skipped with a logged note when its vars (and any required
# CLI/cache) are absent — the skill runs fine without them.
# SAFETY: insights REFUSES to run these sources until you provide a REAL
# anonymize_denylist.txt (the shipped example has fake names only).

# Notion deal-funnel source. Both must be set together to enable it.
# [OPTIONAL] (secret) Notion internal-integration token (https://notion.so/my-integrations)
#NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# [OPTIONAL] (non-secret) the Notion database id insights.py queries.
#NOTION_DEALS_DB_ID=00000000000000000000000000000000
# [OPTIONAL] (non-secret) comma-separated Status values treated as the active
# deal-funnel stages (used by BOTH the Notion query and the insights filter).
#NOTION_KEY_COLUMNS=New Leads,Qualified Leads,Discussion

# Gmail weekly-memo source (needs the `gog` Gmail CLI installed). Both together.
# [OPTIONAL] (non-secret) the account the gog CLI reads for weekly memos
#GMAIL_ACCOUNT=you@yourdomain.com
# [OPTIONAL] (non-secret) sender filter for the weekly-memo search
#SGV_ADMIN_EMAIL=admin@yourdomain.com

# Fireflies transcripts activate only if the cache dir exists on disk.
# [OPTIONAL] (non-secret) override the cache dir location. Default: <state>/fireflies
#SGV_FIREFLIES_CACHE_DIR=/home/youruser/.local/share/sgv-tweet-digest/fireflies

# Call-drafts lane (call_drafts.py): drafts anonymized personal-voice tweets
# from your recent Fireflies calls (two-stage Sonnet, ~$0.05-0.08/call, max 3
# calls/day). Personal channel only. Requires a REAL denylist (same gate as
# insights). [OPTIONAL] (secret) — unset disables the lane entirely.
#FIREFLIES_API_KEY=your_fireflies_api_key

# === Operator-tunable knobs (advanced; ALL OPTIONAL — sane defaults built in) ===
# Path defaults resolve under XDG state (~/.local/share/sgv-tweet-digest) and
# XDG config (~/.config/sgv-tweet-digest) at runtime. Uncomment only to override,
# and use ABSOLUTE paths if this file is loaded by systemd.

# Config file (canonical resolution: $SGV_CONFIG -> ~/.config/sgv-tweet-digest/
# config.json -> <skill_dir>/config.json -> shipped example).
# SGV_DIGEST_CONFIG is a DEPRECATED alias still honored as a fallback.
#SGV_CONFIG=/home/youruser/.config/sgv-tweet-digest/config.json
# voice_profiles.json (default: state dir, then the shipped seed)
#SGV_VOICE_PROFILES=/home/youruser/.local/share/sgv-tweet-digest/voice_profiles.json
# REAL anonymization denylist (default: state-dir anonymize_denylist.txt,
# falling back to the shipped fake-name example)
#SGV_ANONYMIZE_DENYLIST=/home/youruser/.local/share/sgv-tweet-digest/anonymize_denylist.txt
# SQLite feedback.db (the engagement feedback loop; keep OUTSIDE the skill dir)
#SGV_FEEDBACK_DB=/home/youruser/.local/share/sgv-tweet-digest/feedback.db
# Where the JSON run-stats line is appended (default: <state>/stats.jsonl)
#SGV_STATS_PATH=/home/youruser/.local/share/sgv-tweet-digest/stats.jsonl
# Override the bundled send_message.sh / telegram reader (rarely needed)
#SGV_SEND_SCRIPT=/home/youruser/.claude/skills/sgv-tweet-digest/scripts/send_message.sh
#SGV_TELEGRAM_READ=/home/youruser/.claude/skills/sgv-tweet-digest/scripts/telegram/read.py
# The owned-reads file gather_x.py writes AND digest.py reads (keep them in sync
# by setting this ONE var; default: <state>/latest.json on both sides)
#SGV_OWNED_READS=/home/youruser/.local/share/sgv-tweet-digest/latest.json
# Where the refreshed OAuth2 token blob is persisted (seeded from X_OAUTH2_* on
# first run; default: <state>/twitter_oauth2.json)
#X_OAUTH2_TOKEN_FILE=/home/youruser/.local/share/sgv-tweet-digest/twitter_oauth2.json

# --- Behavior toggles / diagnostics ---
# Set truthy to log a one-line steering summary each digest run
#SGV_SHOW_STEERING=1
# Host shown ONLY inside a diagnostic "ssh <host> tail …" hint when gather output
# is missing (default placeholder: <vps-host>)
#SGV_VPS_HOST=my-vps-host

# --- External binaries (resolved from PATH unless overridden) ---
# yt-dlp for the good-content poller's YouTube links
#YTDLP_BIN=/usr/bin/yt-dlp
# gog Gmail CLI for the weekly-memo insights source
#GOG_BIN=/usr/local/bin/gog

# --- Other optional sources / endpoints ---
# Bot @handle the good-content poller ALSO watches for `gc:` links (besides
# Saved Messages). Unset -> only Saved Messages is polled.
#TELEGRAM_GC_BOT=your_gc_bot_handle
# OAuth2 redirect/callback URI for the one-time bootstrap; must match what the
# X app registers. Default: http://localhost:8723/callback
#X_OAUTH2_REDIRECT=http://localhost:8723/callback

# === Auto / standard (you normally do NOT set these) ===
# CLAUDE_SKILL_DIR is set by Claude Code to the installed skill dir; the scripts
# fall back to resolving it from their own path. XDG_DATA_HOME / XDG_CONFIG_HOME
# are standard XDG base dirs (default ~/.local/share and ~/.config) — the scripts
# honor them for state/config locations; override only if your XDG layout differs.
