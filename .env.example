# sgv-tweet-digest — environment template
# ---------------------------------------------------------------------------
# Copy this file to your real env file (e.g. ~/.config/sgv-tweet-digest/env or
# the repo-local .env) and fill in YOUR values. The real .env is gitignored.
# This is the exhaustive list of env-var names the scripts read — the required
# credentials/paths are up top; the advanced operator-tunable knobs (all optional,
# each with a built-in default) are grouped at the bottom. Use these exact names.
# Each operator supplies their OWN credentials (see SECRETS-TO-SHARE.md).
#
# Legend:  [REQUIRED] must be set   [OPTIONAL] feature off if unset
#          (secret)  never commit / never share   (non-secret)  safe to share
# ---------------------------------------------------------------------------

# === Anthropic ===
# [REQUIRED] (secret) Opus + Sonnet calls — the whole product (scoring, drafting,
# insights, good-content, feedback profile, voice-profile rebuild). Get one at
# https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === X / Twitter API ===
# [REQUIRED] (secret) X API v2 app-only Bearer — list members/tweets, following,
# single-tweet fetch (paid metered tier). From your X developer app.
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAxxxxxxxxxxxxxxxxxxxx

# OAuth2 user-token refresh — reads YOUR followed Lists, /following, and own
# timeline (app-only auth 403s on those). Authorize an OAuth2 app against your
# OWN @handle. CLIENT_SECRET is only needed for confidential clients.
# [REQUIRED] (secret)
X_OAUTH2_CLIENT_ID=your_oauth2_client_id
# [OPTIONAL] (secret) only for confidential clients; omit for public clients
X_OAUTH2_CLIENT_SECRET=your_oauth2_client_secret
# [REQUIRED] (secret) the long-lived refresh token that mints access tokens
X_OAUTH2_REFRESH_TOKEN=your_oauth2_refresh_token
# [OPTIONAL] (non-secret) where the refreshed OAuth2 token blob is persisted.
# Seeded from the X_OAUTH2_* vars above on first run. Defaults under XDG state.
X_OAUTH2_TOKEN_FILE=$HOME/.local/share/sgv-tweet-digest/twitter_oauth2.json

# === Telegram ===
# Telethon application credentials from https://my.telegram.org (API development
# tools). Tie a USER session to your account, so keep them private.
# [REQUIRED] (secret)
TELEGRAM_API_ID=1234567
# [REQUIRED] (secret)
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# [REQUIRED] (secret) path to the Telethon user-session file. Created on first
# login (one-time phone+code). NEVER share it — concurrent use revokes it.
TELEGRAM_SESSION=$HOME/.local/share/sgv-tweet-digest/session.session
# [REQUIRED] (secret) BotFather bot token for personal (mist-voice) DM delivery.
# The bot's @handle is derived from this token — no handle is hardcoded.
TELEGRAM_BOT_TOKEN=123456:ABC-DEFxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [REQUIRED] (non-secret) Telegram group id for fund (sgv-voice) delivery.
# Supergroup ids look like -100xxxxxxxxxx.
TELEGRAM_DELIVERY_CHAT_SGV=-1001234567890
# [REQUIRED] (non-secret) Telegram user/DM id for personal (mist-voice) delivery.
TELEGRAM_DELIVERY_CHAT_MIST=123456789
# [OPTIONAL] (non-secret) Telegram news channel/username the digest reads for
# market context. Omit to skip the news-context pull.
SHOAL_CHANNEL=shoalresearch

# === Paths / runtime ===
# [OPTIONAL] (non-secret) SQLite feedback.db path (the engagement feedback loop).
# Defaults under XDG state; keep it OUTSIDE the skill dir.
SGV_FEEDBACK_DB=$HOME/.local/share/sgv-tweet-digest/feedback.db
# [REQUIRED] (non-secret) Telethon-capable Python interpreter (the digest + all
# Telegram I/O). The stdlib-only gatherers can use system python3.
VENV_PYTHON=$HOME/.local/share/sgv-tweet-digest/venv/bin/python3

# === Optional sources (insights.py) ===
# Each source below is skipped with a logged note when its vars (and any required
# CLI/cache) are absent — the skill runs fine without them.

# Notion deal-funnel source. Both must be set together to enable it.
# [OPTIONAL] (secret) Notion internal-integration token (https://notion.so/my-integrations)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# [OPTIONAL] (non-secret) the Notion database id insights.py queries. Required only if NOTION_TOKEN is set.
NOTION_DEALS_DB_ID=00000000000000000000000000000000

# Gmail weekly-memo source (needs the `gog` Gmail CLI installed). Both together.
# [OPTIONAL] (non-secret) the account the gog CLI reads for weekly memos
GMAIL_ACCOUNT=you@yourdomain.com
# [OPTIONAL] (non-secret) sender filter for the weekly-memo search. Required only if GMAIL_ACCOUNT is set.
SGV_ADMIN_EMAIL=admin@yourdomain.com

# Fireflies transcript source has no ENABLE var: it activates only if its
# transcript-cache directory exists on disk. The directory LOCATION is overridable:
# [OPTIONAL] (non-secret) Fireflies transcript-cache dir insights.py scans for
# transcripts_*.json. Default: <state>/fireflies/ (insights.py).
SGV_FIREFLIES_CACHE_DIR=$HOME/.local/share/sgv-tweet-digest/fireflies

# [OPTIONAL] (non-secret) comma-separated Notion Status values treated as the deal
# funnel's "key" stages. Overrides the built-in default funnel stages (notion_client.py).
NOTION_KEY_COLUMNS=Term Sheet,Closed,Portfolio

# === Operator-tunable knobs (advanced; all OPTIONAL) ===
# Everything below has a sane built-in default — set one only to override. These
# are the remaining names the scripts read; none is a credential.

# --- Config / profile / state paths ---
# [OPTIONAL] (non-secret) path to your config.json. The gatherers (gather_x.py,
# our_tweets_fetcher.py) and digest.py/insights.py/good_content.py/build_voice_profiles.py
# all read THIS one name. Default: $XDG_CONFIG_HOME/sgv-tweet-digest/config.json (or the
# state dir), falling back to the shipped config.example.json.
# (SGV_DIGEST_CONFIG is a DEPRECATED alias still honored by gather_x.py as a fallback;
#  prefer SGV_CONFIG.)
SGV_CONFIG=$HOME/.config/sgv-tweet-digest/config.json
# [OPTIONAL] (non-secret) path to voice_profiles.json. Default: state dir, then the
# shipped seed (digest.py, good_content.py, insights.py).
SGV_VOICE_PROFILES=$HOME/.local/share/sgv-tweet-digest/voice_profiles.json
# [OPTIONAL] (non-secret) real anonymization denylist path. Default: state-dir
# anonymize_denylist.txt, falling back to the shipped example (insights.py).
SGV_ANONYMIZE_DENYLIST=$HOME/.local/share/sgv-tweet-digest/anonymize_denylist.txt
# [OPTIONAL] (non-secret) where the JSON run-stats line is appended.
# Default: <state>/stats.jsonl (digest.py).
SGV_STATS_PATH=$HOME/.local/share/sgv-tweet-digest/stats.jsonl
# [OPTIONAL] (non-secret) override the path to send_message.sh.
# Default: the bundled scripts/send_message.sh (digest.py).
SGV_SEND_SCRIPT=$HOME/.claude/skills/sgv-tweet-digest/scripts/send_message.sh
# [OPTIONAL] (non-secret) override the path to the Telegram news reader.
# Default: the bundled scripts/telegram/read.py (digest.py).
SGV_TELEGRAM_READ=$HOME/.claude/skills/sgv-tweet-digest/scripts/telegram/read.py
# [OPTIONAL] (non-secret) override the owned-reads input the digest consumes
# (written by gather_x.py). Default: <state>/latest.json (digest.py).
SGV_OWNED_READS=$HOME/.local/share/sgv-tweet-digest/latest.json

# --- Behavior toggles / diagnostics ---
# [OPTIONAL] (non-secret) set truthy to log a one-line steering summary each run (digest.py).
SGV_SHOW_STEERING=1
# [OPTIONAL] (non-secret) host shown ONLY inside a diagnostic "ssh <host> tail …" hint
# when the gather output is missing. Default placeholder: <vps-host> (digest.py).
SGV_VPS_HOST=<vps-host>

# --- External binaries (resolved from PATH unless overridden) ---
# [OPTIONAL] (non-secret) yt-dlp binary path for the good-content poller's YouTube
# links. Default: yt-dlp on PATH (good_content_poll.py).
YTDLP_BIN=/usr/bin/yt-dlp
# [OPTIONAL] (non-secret) gog Gmail CLI path for the weekly-memo insights source.
# Default: gog on PATH (insights.py).
GOG_BIN=/usr/local/bin/gog

# --- Other optional sources / endpoints ---
# [OPTIONAL] (non-secret) bot @handle the good-content poller also watches for `gc:`
# links (besides Saved Messages). Unset → only Saved Messages is polled (good_content_poll.py).
TELEGRAM_GC_BOT=your_gc_bot_handle
# [OPTIONAL] (non-secret) OAuth2 redirect/callback URI for the one-time bootstrap;
# must match what the X app registers. Default: http://localhost:8723/callback
# (oauth_bootstrap.py).
X_OAUTH2_REDIRECT=http://localhost:8723/callback

# === Auto / standard (you normally do NOT set these) ===
# CLAUDE_SKILL_DIR is set by Claude Code to the installed skill dir; the scripts fall
# back to resolving it from their own path, so you rarely set it by hand. XDG_DATA_HOME
# and XDG_CONFIG_HOME are standard XDG base dirs (default ~/.local/share and ~/.config);
# the scripts honor them for state/config locations — override only if your XDG layout differs.
